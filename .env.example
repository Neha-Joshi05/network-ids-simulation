# Network IDS Simulation — Environment Variables
# Copy this file to .env and fill in your values

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///data/ids.db

# IDS Engine Settings
IDS_RISK_THRESHOLD_SUSPICIOUS=40
IDS_RISK_THRESHOLD_HIGH=65
IDS_RISK_THRESHOLD_CRITICAL=80

# Rule Weights (must sum to 1.0)
RULE_WEIGHT=0.40
ANOMALY_WEIGHT=0.30
ML_WEIGHT=0.30

# Alert Settings
ALERT_CORRELATION_WINDOW_SECONDS=60
MAX_ALERTS_PER_SOURCE=10

# Simulator Settings
SIMULATOR_SPEED=normal   # slow / normal / fast
SIMULATOR_MODE=mixed     # normal / mixed
